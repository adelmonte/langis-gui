[Desktop Entry]
Type=Application
Name=langis
GenericName=Signal client
Comment=Unofficial Signal client on langis
Exec=langis-gui %u
Icon=langis
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=signal;messenger;chat;
